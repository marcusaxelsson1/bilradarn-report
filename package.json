{
  "name": "bilradarn-report",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:vite": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "data:import": "node scripts/import-wayke.mjs",
    "data:lease": "node scripts/import-leasing.mjs",
    "data:report": "node scripts/build-report.mjs",
    "data:queue": "node scripts/build-research-queue.mjs",
    "data:research": "node scripts/research-costs.mjs",
    "data:images": "node scripts/cache-images.mjs",
    "data:pipeline": "node scripts/run-data-pipeline.mjs",
    "data:refresh": "npm run data:import && npm run data:lease && npm run data:report && npm run data:queue && npm run data:images",
    "test:data": "node --test tests/import-wayke.test.mjs",
    "test:economics": "node --test tests/report.test.mjs",
    "test:queue": "node --test tests/research-queue.test.mjs",
    "test:charts": "node --test tests/chart-view-model.test.mjs",
    "test:compare": "node --test tests/compare-model.test.mjs",
    "test:scenario": "node --test tests/scenario.test.mjs",
    "test:economics-engine": "node --test tests/economics-engine.test.mjs",
    "test:enrichment-adapter": "node --test tests/vehicle-enrichment-adapter.test.mjs",
    "test:cost-sources": "node --test tests/cost-source-adapters.test.mjs",
    "registry:assist": "node scripts/registry-assistant.mjs",
    "registry:export": "node scripts/export-registry-public.mjs",
    "registry:bridge": "node scripts/registry-bridge.mjs",
    "prototype:contract": "node prototypes/offer-contract/tui.mjs",
    "prototype:cost": "node prototypes/cost-engine/tui.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
